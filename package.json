{
  "name": "oscilloscope-simulator",
  "version": "1.0.0",
  "description": "示波器仿真系统 - 交互式电子教学工具",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "set NODE_ENV=development && webpack serve --config webpack.config.js --hot",
    "start": "npm run dev",
    "build": "set NODE_ENV=production && webpack --config webpack.config.js --mode production --optimization-minimize && node packaging/optimize-build.js",
    "electron": "electron .",
    "electron:dev": "set NODE_ENV=development && concurrently \"npm run dev\" \"wait-on http://localhost:8081 && electron .\"",
    "electron:build": "npm run dist",
    "electron:build-all": "npm run dist:all",
    "electron:build-all:local": "npm run dist:all:local",
    "electron:build-win": "npm run dist:win",
    "electron:build-win:local": "npm run dist:win:local",
    "electron:build-mac": "npm run dist:mac",
    "electron:build-linux": "npm run dist:linux",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:all": "npm run build && node packaging/build.js all",
    "dist:all:local": "npm run build && node packaging/build.js all local",
    "dist:win": "npm run build && node packaging/build.js win",
    "dist:win:local": "npm run build && node packaging/build.js win local",
    "dist:mac": "npm run build && node packaging/build.js mac",
    "dist:linux": "npm run build && node packaging/build.js linux",
    "release": "npm run build && electron-builder --publish=always"
  },
  "build": {
    "appId": "com.oscilloscope.simulator",
    "productName": "示波器仿真系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "docs/**/*",
      "assets/**/*",
      "!docs/**/*.map"
    ],
    "extraResources": [
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "示波器仿真系统"
    },
    "dmg": {
      "title": "示波器仿真系统"
    },
    "publish": {
      "provider": "github",
      "owner": "1x2x3x4",
      "repo": "demo1"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "dat.gui": "^0.7.9",
    "three": "^0.177.0",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "wait-on": "^7.2.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
